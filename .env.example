# Copy to .env, replace placeholders, then export as described in README.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=focus_garden
DB_USERNAME=focus_garden
DB_PASSWORD=replace_with_local_password
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Independent integration database: fixed schema focus_garden_test.
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USERNAME=focus_garden_test
TEST_DB_PASSWORD=replace_with_test_password

# Required: generate once with `openssl rand -base64 32`; same stable secret across instances.
AUTH_CODE_HMAC_KEY=replace_with_base64_random_32_byte_secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=noreply@example.com
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
# Production: SPRING_PROFILES_ACTIVE=prod; HTTPS ingress and secure cookie are required.
SESSION_COOKIE_SECURE=false
# Explicit local Mailpit capture: SPRING_PROFILES_ACTIVE=local-mail
